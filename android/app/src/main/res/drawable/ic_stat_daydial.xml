<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon.

  Android requires the small icon to be a flat white silhouette on transparent: the
  system tints it to match the theme and discards any colour in the source, so a
  full-colour launcher icon here renders as a solid white blob. A vector is the right
  shape for this — a 24dp clock face with two hands, which is the whole app.

  Without an explicit smallIcon the plugin falls back to android.R.drawable.ic_dialog_info,
  a stock information glyph that has nothing to do with a study planner. That is only a
  cosmetic problem, but a reminder from a timer app should not wear someone else's icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Clock face: an open ring, stroked so the centre stays clear. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM12,20c-4.41,0 -8,-3.59 -8,-8s3.59,-8 8,-8 8,3.59 8,8 -3.59,8 -8,8z" />
    <!-- Hour hand, pointing at 10 o'clock. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,6.5c-0.28,0 -0.5,0.22 -0.5,0.5v5.09l-3.15,1.87c-0.24,0.14 -0.32,0.44 -0.18,0.68 0.14,0.24 0.44,0.32 0.68,0.18l3.42,-2.03c0.15,-0.09 0.24,-0.25 0.24,-0.42V7c0,-0.28 -0.22,-0.5 -0.5,-0.5z" />
    <!-- Minute hand, pointing at 12. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12.5,10.5h-1v5.5c0,0.28 0.22,0.5 0.5,0.5s0.5,-0.22 0.5,-0.5v-5.5z" />
</vector>