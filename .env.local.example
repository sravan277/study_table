# ─────────────────────────────────────────────────────────────────────────────
#  The app runs fully without any of these. It falls back to localStorage and
#  in-page notifications. Fill them in and it upgrades itself — no code changes.
#  Full walkthrough: docs/SETUP_SUPABASE.md
# ─────────────────────────────────────────────────────────────────────────────

# Dashboard → Project Settings → API Keys
# Copy this file to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ramcharan27745
# Server only. Never prefix with NEXT_PUBLIC_. The publishable key replaces the
# old anon key; the secret key replaces service_role. Both legacy ones still work.
SUPABASE_SECRET_KEY=

# Web Push — generate with:  npm run vapid
# The private key is RAW BASE64URL, not PEM. If it starts with "-----BEGIN" it is wrong.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secret required by POST /api/push/send. pg_cron reads it from Supabase
# Vault; this is the fallback for local testing.
PUSH_DISPATCH_SECRET=change-me